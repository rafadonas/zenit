APP_ENV=development
APP_NAME=zenit
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://zenit:change_me@postgres:5432/zenit
AUTH_SECRET_KEY=development-only-change-this-authentication-secret
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_TOKEN_ISSUER=zenit
AUTH_TOKEN_AUDIENCE=zenit-api
RECOMMENDATION_REVIEW_POLICY_VERSION=recommendation-review-mvp-v1
INSPECTION_ORDER_POLICY_VERSION=prepared-inspection-order-v1
PREPARED_PHOTO_REVIEW_POLICY_VERSION=prepared-photo-review-v1
PREPARED_INSPECTION_SUMMARY_POLICY_VERSION=prepared-inspection-summary-v1
PREPARED_POST_INSPECTION_POLICY_VERSION=prepared-post-inspection-v1
PREPARED_MOWING_ORDER_POLICY_VERSION=prepared-mowing-order-v1
PREPARED_MOWING_RESOURCE_POLICY_VERSION=prepared-mowing-resource-plan-v1
DASHBOARD_APP_ENV=development
DASHBOARD_PUBLIC_ORIGIN=http://localhost:3000
DASHBOARD_COOKIE_SECURE=false
POSTGRES_DB=zenit
POSTGRES_USER=zenit
POSTGRES_PASSWORD=change_me
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=zenit
OBJECT_STORAGE_SECRET_KEY=change_me
OBJECT_STORAGE_BUCKET_RAW=zenit-raw
OBJECT_STORAGE_BUCKET_PROCESSED=zenit-processed
OBJECT_STORAGE_BUCKET_MEDIA=zenit-media
# Base64-encoded 32-byte application encryption key. Replace outside local development.
OBJECT_STORAGE_MEDIA_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS0zMi1ieXRlLWtleSEhISE=
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_GENERAL_THRESHOLD_CM=30
DEFAULT_SPECIAL_THRESHOLD_CM=10
ALLOW_SIMULATED_LOCATION=false
ALLOW_DEMO_RESET=false
TRAINING_DATA_ENABLED=false
OFFICIAL_REPORTS_ENABLED=false
# Server/worker-only satellite credentials. Keep placeholders empty in source control.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
BDC_ACCESS_TOKEN=
